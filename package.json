{
  "name": "@skit/x.naive-ui",
  "title": "X Naive-UI",
  "description": "一个对 Naive-UI 组件库的扩展，使 DataTable/Dropdown/Menu/Select/Tree 等组件支持插槽模板式的写法。An extension to Naive-UI component library, that enables slots and template style API for DataTable/Dropdown/Menu/Select/Tree.",
  "keywords": [
    "naive-ui",
    "component library",
    "ui framework",
    "ui",
    "vue",
    "vue3"
  ],
  "version": "0.19.0",
  "author": "Fu Diwei",
  "repository": {
    "type": "git",
    "url": "https://github.com/fudiwei/x.naive-ui.git"
  },
  "license": "MIT",
  "type": "module",
  "main": "lib/index.cjs",
  "module": "es/index.mjs",
  "types": "es/index.d.ts",
  "files": [
    "dist/*",
    "lib/*",
    "es/*",
    "types/*",
    "!types/shims-*.d.ts"
  ],
  "exports": {
    ".": {
      "require": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.cjs"
      },
      "import": {
        "types": "./es/index.d.ts",
        "default": "./es/index.mjs"
      }
    },
    "./unplugin": {
      "require": {
        "types": "./lib/unplugin.d.ts",
        "default": "./lib/unplugin.cjs"
      },
      "import": {
        "types": "./es/unplugin.d.ts",
        "default": "./es/unplugin.mjs"
      }
    },
    "./types/*": {
      "default": "./types/*"
    },
    "./*": {
      "require": "./lib/*",
      "import": "./es/*"
    }
  },
  "engines": {
    "node": ">=18.18",
    "npm": ">=8",
    "pnpm": ">=8"
  },
  "scripts": {
    "build": "pnpm run gen-dist && pnpm run gen-dts && pnpm run gen-volar",
    "gen-dist": "rollup -c",
    "gen-dts": "vue-tsc -p tsconfig.dts-cjs.json && vue-tsc -p tsconfig.dts-esm.json",
    "gen-volar": "esbuild scripts/gen-volar.js --bundle --platform=node --tsconfig=tsconfig.esbuild.json | node",
    "demo": "vite --config demo/vite.config.ts",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@babel/core": "^7.26.7",
    "@babel/preset-env": "^7.26.7",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@rollup/plugin-typescript": "^12.3.1",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^18.16.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitejs/plugin-vue-jsx": "^4.2.0",
    "@vue/babel-plugin-jsx": "^1.5.0",
    "@vue/compiler-sfc": "^3.5.45",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-standard": "^9.0.1",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/runtime-core": "^3.5.45",
    "deepmerge": "^4.3.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-vue": "^9.33.0",
    "highlight.js": "^11.12.0",
    "naive-ui": "^2.45.3",
    "prettier": "^3.10.1",
    "rollup": "^4.68.7",
    "rollup-plugin-esbuild": "^6.2.1",
    "rollup-plugin-string": "^3.0.0",
    "rollup-plugin-vue": "^6.0.0",
    "treemate": "^0.3.11",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vite-svg-loader": "^5.1.3",
    "vue": "^3.5.45",
    "vue-router": "^4.6.5",
    "vue-tsc": "^3.3.14",
    "vueuc": "^0.4.66"
  },
  "peerDependencies": {
    "naive-ui": "^2.37.0",
    "vue": "^3.2.0"
  },
  "sideEffects": false,
  "unpkg": "dist/index.prod.js",
  "jsdelivr": "dist/index.prod.js"
}
